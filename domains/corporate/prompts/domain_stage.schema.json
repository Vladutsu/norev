{
  "type": "object",
  "properties": {
    "calendar_events_said": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 300}
    },
    "added_actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "action_type": {"const": "calendar_event"},
              "title": {"type": "string", "minLength": 1, "maxLength": 200},
              "description": {"type": "string", "maxLength": 400},
              "transcript_excerpt": {"type": "string", "minLength": 1, "maxLength": 300},
              "owner": {"anyOf": [{"type": "string", "enum": ["organizer", "participant"]}, {"type": "null"}]},
              "fields": {
                "type": "object",
                "properties": {
                  "event_date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]},
                  "start_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "end_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "location": {"type": ["string", "null"]},
                  "attendees": {"type": "null"}
                },
                "required": ["event_date", "start_time", "end_time", "location", "attendees"],
                "additionalProperties": false
              }
            },
            "required": ["action_type", "title", "description", "transcript_excerpt", "owner", "fields"],
            "additionalProperties": false
          }
        ]
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "action_type": {"const": "work_item"},
              "owner": {"anyOf": [{"type": "string", "enum": ["organizer", "participant"]}, {"type": "null"}]},
              "fields": {
                "type": "object",
                "properties": {
                  "deliverable": {"type": ["string", "null"]}
                },
                "required": ["deliverable"],
                "additionalProperties": false
              }
            },
            "required": ["id", "action_type", "owner", "fields"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "action_type": {"const": "calendar_event"},
              "owner": {"anyOf": [{"type": "string", "enum": ["organizer", "participant"]}, {"type": "null"}]},
              "fields": {
                "type": "object",
                "properties": {
                  "event_date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]},
                  "start_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "end_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "location": {"type": ["string", "null"]},
                  "attendees": {"type": "null"}
                },
                "required": ["event_date", "start_time", "end_time", "location", "attendees"],
                "additionalProperties": false
              }
            },
            "required": ["id", "action_type", "owner", "fields"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "action_type": {"const": "follow_up_email"},
              "owner": {"anyOf": [{"type": "string", "enum": ["organizer", "participant"]}, {"type": "null"}]},
              "fields": {
                "type": "object",
                "properties": {
                  "recipients": {"type": "null"},
                  "subject": {"type": ["string", "null"]},
                  "body": {"type": ["string", "null"]}
                },
                "required": ["recipients", "subject", "body"],
                "additionalProperties": false
              }
            },
            "required": ["id", "action_type", "owner", "fields"],
            "additionalProperties": false
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "transcript_excerpt": {"type": "string"}
        },
        "required": ["text", "transcript_excerpt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["calendar_events_said", "added_actions", "proposed_actions", "suggestions"],
  "additionalProperties": false
}
