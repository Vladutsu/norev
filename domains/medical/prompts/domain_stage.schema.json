{
  "type": "object",
  "properties": {
    "proposed_actions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "action_type": {"const": "schedule_visit"},
              "fields": {
                "type": "object",
                "properties": {
                  "reason": {"type": ["string", "null"]},
                  "visit_date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]},
                  "visit_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "visit_end_time": {"anyOf": [{"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}, {"type": "null"}]},
                  "location": {"type": ["string", "null"]}
                },
                "required": ["reason", "visit_date", "visit_time", "visit_end_time", "location"],
                "additionalProperties": false
              }
            },
            "required": ["id", "action_type", "fields"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "action_type": {"const": "medication_reminder"},
              "fields": {
                "type": "object",
                "properties": {
                  "medication": {"type": ["string", "null"]},
                  "dose": {"type": ["string", "null"]},
                  "frequency": {"type": ["string", "null"]},
                  "times": {"type": ["string", "null"]},
                  "start_date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]},
                  "end_date": {"anyOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, {"type": "null"}]}
                },
                "required": ["medication", "dose", "frequency", "times", "start_date", "end_date"],
                "additionalProperties": false
              }
            },
            "required": ["id", "action_type", "fields"],
            "additionalProperties": false
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "transcript_excerpt": {"type": "string"}
        },
        "required": ["text", "transcript_excerpt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["proposed_actions", "suggestions"],
  "additionalProperties": false
}
